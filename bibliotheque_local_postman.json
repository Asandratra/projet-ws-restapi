{
  "info": {
    "name": "Bibliothèque REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token",   "value": "" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mail\": \"admin@mail.com\",\n  \"mdp\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Rakoto\",\n  \"prenom\": \"Jean\",\n  \"telephone\": \"0341234567\",\n  \"mail\": \"jean@mail.com\",\n  \"mdp\": \"password123\",\n  \"confirmMdp\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Update JWT Expiration (ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/config/jwt-expiration?duration=10800000",
              "host": ["{{baseUrl}}"],
              "path": ["api","auth","config","jwt-expiration"],
              "query": [{ "key": "duration", "value": "10800000" }]
            }
          }
        }
      ]
    },

